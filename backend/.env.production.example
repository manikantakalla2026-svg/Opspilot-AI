# Copy values into Render environment settings, never commit a populated file.
# Pooled Neon URL, TLS required. Use a synthetic-data demo branch for public demos.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/neondb?sslmode=require
WORKSPACE_TOKEN=replace-with-a-long-random-secret
# Exact Cloudflare Pages origin, no trailing slash, JSON array.
FRONTEND_ORIGINS=["https://YOUR-PROJECT.pages.dev"]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_EXTERNAL_ENABLED=false
AI_DAILY_INVESTIGATION_LIMIT=10
AI_GLOBAL_DAILY_REQUEST_LIMIT=50
AI_REQUEST_COOLDOWN_SECONDS=5
AI_TIMEOUT_SECONDS=12
# For manual Alembic migrations only; not needed by the running API:
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require
