# Copy to .env and replace with the connection string from Neon > Connect.
# Leave DATABASE_URL unset until you have a real connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=require&channel_binding=require
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Shared single-workspace administrative token. Generated locally in backend/.env.
# WORKSPACE_TOKEN=replace-with-a-random-secret

# Incident analysis (backend only; never use VITE_ prefixed secrets)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_EXTERNAL_ENABLED=false
AI_DAILY_INVESTIGATION_LIMIT=10
AI_GLOBAL_DAILY_REQUEST_LIMIT=50
AI_REQUEST_COOLDOWN_SECONDS=5
AI_TIMEOUT_SECONDS=12
